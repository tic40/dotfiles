# sheldon (adds plugin completions to fpath, so must be before compinit)
eval "$(sheldon source)"

# completion
autoload -Uz compinit
compinit
setopt auto_cd
setopt auto_pushd
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

setopt hist_ignore_dups
setopt hist_ignore_space
setopt share_history

# aliases
REPO="$HOME/ghq/github.com"
GCCAC="g++ -std=gnu++2b -O2 -Wall -Wextra -I ${REPO}/tic40/atcoder/libraries/ac-library main.cpp"

alias vi='nvim'
alias vim='nvim'
alias ls='ls -G'
alias ll='ls -alGh'
alias gccac="${GCCAC}"
alias gccace="${GCCAC} && ./a.out"
alias runtest="${REPO}/tic40/atcoder/scripts/runTest.sh"
alias zj='zellij'

alias repo="cd \$(ghq list -p | fzf)"
alias poc-note="cd ${REPO}/pocake/note"

unset REPO GCCAC

alias ghreview='gh pr list --search "review-requested:@me"'
alias gbc='git branch --show-current | pbcopy'

alias clauded='claude --dangerously-skip-permissions'
alias untar='tar -xvf'
alias getpass='openssl rand -base64 20'
alias sha='shasum -a 256'
alias ping='ping -c 5'
alias www='python3 -m http.server'
alias speed='networkQuality'
alias ipe='curl ipinfo.io/ip'
alias ipi='ipconfig getifaddr en0'
alias big10='du -sh ./* | sort -hr | head -n 10'
alias vil='nvim "$(ls | sort | tail -1)"'
alias cformat='clang-format -style=file -i'
alias char100='for i in {1..100}; do echo -n 'a'; done'
alias fizzbuzz='for i in {1..100}; do ([ $((i%15)) = 0 ] && echo 'fizzbuzz') || ([ $((i%3)) = 0 ] && echo 'fizz') || ([ $((i%5)) = 0 ] && echo 'buzz') || echo $i; done'
alias wcnt='wc -m'

# Downloads の test<数字> ファイルをカレントディレクトリに移動する
movetest() {
  mv -- ~/Downloads/test<->(N.) .
}

mkcd() { mkdir -p -- "$1" && cd -- "$1" }

# mise
eval "$(mise activate zsh)"
# atuin
eval "$(atuin init zsh)"
# for claude code
export PATH="$HOME/.local/bin:$PATH"
# starship
eval "$(starship init zsh)"

export EDITOR=nvim

# Load local config (secrets, machine-specific settings)
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
