[user]
  name = tic40
  email = ccpzjoh@gmail.com
[alias]
  br = branch
  bra = branch -a
  brc = branch --show-current
  brr = branch -r
  cm = commit -m
  cma = commit --amend
  cme = commit --allow-empty -m
  co = checkout
  df = diff
  dfc = diff --color-words
  fe = fetch
  fpa = !ghq list | ghq get --update --parallel
  lone = log --date=short --pretty=format:'%C(yellow)%h %Cgreen%cd %Cblue%cn %Creset%s'
  ls = ls-files
  lsd = ls-files --deleted
  lsm = ls-files --modified
  pushf = push --force-with-lease --force-if-includes
  rank = shortlog -sn --no-merges HEAD
  rank-month = "!git shortlog -sn --no-merges --since=\"$(date +%Y-%m-01) 00:00\" HEAD"
  st = status
  sw = switch
  up = pull
[core]
  excludesfile = ~/.gitignore_global
  quotepath = false
  editor = nvim
  whitespace = cr-at-eol
  hooksPath = ~/.config/git/hooks
  fsmonitor = true
  untrackedCache = true
[init]
  defaultBranch = main
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[commit]
  verbose = true
[pull]
  ff = only
[push]
  autoSetupRemote = true
  followTags = true
[fetch]
  prune = true
  pruneTags = true
[rebase]
  autoStash = true
  autoSquash = true
  updateRefs = true
[merge]
  conflictStyle = zdiff3
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
[rerere]
  enabled = true
  autoUpdate = true
[help]
  autocorrect = prompt
[include]
  path = ~/.gitconfig.local
