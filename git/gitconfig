[user]
  name = tic40
  email = ccpzjoh@gmail.com
[alias]
  br = branch
  brc = branch --show-current
  bra = branch -a
  brr = branch -r
  c-rank = shortlog -sn --no-merges
  c-rank-month = "!git shortlog -sn --no-merges --after=\"$(date +%Y/%m/01)\" --before=\"$(date +%Y/%m/%d)\""
  cm = commit -m
  cma = commit --amend
  cme = commit --allow-empty -m
  co = checkout
  conf = config list
  df = diff
  dfc = diff --color-words
  fe = fetch
  info = remote show origin
  l = log --date=short --pretty=format:'%C(yellow)%h %Cgreen%cd %Cblue%cn %Creset%s'
  lone = log --oneline
  ls = ls-files
  lsd = ls-files --deleted
  lsm = ls-files --modified
  pushf = push --force-with-lease
  rmall = "!git ls-files -dz | xargs -0 git rm --"
  st = status
  sw = switch
[core]
  excludesfile = ~/.gitignore_global
  quotepath = false
  editor = nvim
  whitespace = cr-at-eol
  fsmonitor = true
  untrackedCache = true
[init]
  defaultBranch = main
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[commit]
  verbose = true
[pull]
  ff = only
[push]
  autoSetupRemote = true
  followTags = true
[fetch]
  prune = true
  pruneTags = true
[rebase]
  autoStash = true
  autoSquash = true
  updateRefs = true
[merge]
  conflictStyle = zdiff3
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
[rerere]
  enabled = true
  autoUpdate = true
[help]
  autocorrect = prompt
[include]
  path = ~/.gitconfig.local
