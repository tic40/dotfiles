[user]
  name = tic40
  email = ccpzjoh@gmail.com
[alias]
  br = branch
  brc = branch --show-current
  bra = branch -a
  brr = branch -r
  c = commit
  c-rank = shortlog -sn --no-merges
  c-rank-month = "!git shortlog -sn --no-merges --after=\"$(date +%Y/%m/01)\" --before=\"$(date +%Y/%m/%d)\""
  cm = commit -m
  cma = commit --amend
  cme = commit --allow-empty -m
  co = checkout
  cob = checkout -b
  conf = config --list
  df = diff
  dfc = diff --color-words
  fe = fetch
  fp = !git fetch && git pull
  info = remote show origin
  l = log --date=short --pretty=format:'%C(yellow)%h %Cgreen%cd %Cblue%cn %Creset%s'
  lone = log --oneline
  ls = ls-files
  lsd = ls-files --deleted
  lsm = ls-files --modified
  pushf = push --force-with-lease
  r = reset
  re = restore
  rh = reset --hard
  rhh = reset --hard HEAD
  rl = reflog show
  rmall = "!git ls-files -dz | xargs -0 git rm --"
  rs = reset --soft
  rsh = reset --soft HEAD
  st = status
  sw = switch
[core]
  excludesfile = ~/.gitignore_global
  quotepath = false
  editor = nvim
  whitespace = cr-at-eol
[pull]
  ff = only
[init]
  defaultBranch = main
[push]
  autoSetupRemote = true
[fetch]
  prune = true
[rebase]
  autoStash = true
[merge]
  conflictstyle = zdiff3
[diff]
  algorithm = histogram
[rerere]
  enabled = true
[include]
  path = ~/.gitconfig.local
